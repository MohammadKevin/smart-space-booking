  "CreateDiscountDto": {
    "type": "object",
    "properties": {
      "namaDiskon": {
        "type": "string",
        "example": "Promo Diskon Awal Tahun 2026",
        "description": "Nama program promo / diskon"
      },
      "kodeDiskon": {
        "type": "string",
        "example": "PROMO2026",
        "description": "Kode kupon promo yang dapat dimasukkan saat reservasi"
      },
      "persentaseDiskon": {
        "type": "number",
        "example": 20,
        "description": "Besaran persentase potongan harga (1 - 100%)"
      },
      "tanggalAwal": {
        "type": "string",
        "example": "2026-01-01T00:00:00.000Z",
        "description": "Tanggal & waktu mulai berlakunya promo (ISO-8601 string)"
      },
      "spaceId": {
        "type": "number",
        "example": 1,
        "description": "ID Ruangan spesifik yang dikenakan promo (opsional, jika kosong berlaku untuk semua ruangan)"
      },
      "tanggalAkhir": {
        "type": "string",
        "example": "2026-12-31T23:59:59.000Z",
        "description": "Tanggal & waktu berakhirnya promo (ISO-8601 string)"
      }
    },
    "required": [
      "namaDiskon",
      "persentaseDiskon",
      "tanggalAwal",
      "tanggalAkhir"
    ]
  },
