  "ResendOtpDto": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "example": "user@example.com",
        "description": "Email pengguna yang akan dikirimi ulang OTP"
      },
      "type": {
        "type": "string",
        "example": "register",
