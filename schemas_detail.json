  "ResetPasswordDto": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "example": "user@example.com",
        "description": "Email akun yang sedang di-reset"
      },
      "otp": {
        "type": "string",
        "example": "123456",
        "description": "6-digit kode reset OTP"
      },
      "password": {
        "type": "string",
        "example": "newpassword123*",
        "description": "Kata sandi baru (minimal 6 karakter)"
