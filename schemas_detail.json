{
  "LoginDto": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "example": "john@example.com",
        "description": "Email akun pengguna"
      },
      "password": {
        "type": "string",
        "example": "password123",
        "description": "Password akun pengguna (minimal 6 karakter)"
      }
    },
    "required": [
      "email",
      "password"
    ]
  },
  "GoogleLoginDto": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string",
        "description": "ID Token atau Access Token dari Google OAuth / Credential",
        "example": "eyJhbGciOiJSUzI1NiIsImtpZCI..."
      },
      "name": {
        "type": "string",
        "description": "Nama pengguna dari profil Google",
        "example": "John Doe"
      },
      "email": {
        "type": "string",
        "description": "Alamat email pengguna Google",
        "example": "johndoe@gmail.com"
      },
      "avatar": {
        "type": "string",
        "description": "URL foto avatar profil Google",
        "example": "https://lh3.googleusercontent.com/a/..."
      }
    },
    "required": [
      "token"
    ]
  },
  "RegisterMemberDto": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "example": "member@example.com",
        "description": "Email unik untuk member"
      },
      "password": {
        "type": "string",
        "example": "password123",
        "description": "Password untuk akun member (minimal 6 karakter)"
