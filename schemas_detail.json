  "CreateReservationDto": {
    "type": "object",
    "properties": {
      "spaceId": {
        "type": "number",
        "example": 1,
        "description": "ID Workstation / Ruangan yang dipesan"
      },
      "space_id": {
        "type": "number",
        "example": 1,
        "description": "Alias snake_case untuk spaceId (opsional jika spaceId diisi)"
      },
      "tanggalReservasi": {
        "type": "string",
        "example": "2026-09-10",
        "description": "Tanggal reservasi (format YYYY-MM-DD atau ISO string)"
      },
      "tanggal_reservasi": {
        "type": "string",
        "example": "2026-09-10",
        "description": "Alias snake_case untuk tanggalReservasi"
      },
      "tanggal": {
        "type": "string",
        "example": "2026-09-10",
        "description": "Alias pendek untuk tanggalReservasi"
      },
      "jamMulai": {
        "type": "string",
        "example": "09:00",
        "description": "Jam mulai reservasi (format HH:mm, 24 jam)"
      },
      "jam_mulai": {
        "type": "string",
        "example": "09:00",
        "description": "Alias snake_case untuk jamMulai"
      },
      "durasiJam": {
        "type": "number",
        "example": 3,
        "description": "Durasi pemakaian dalam jam (minimal 1 jam, maksimal 24 jam)"
      },
      "durasi_jam": {
        "type": "number",
        "example": 3,
        "description": "Alias snake_case untuk durasiJam"
      },
      "durasi": {
        "type": "number",
        "example": 3,
        "description": "Alias pendek untuk durasiJam"
      },
      "diskonId": {
        "type": "number",
        "example": 1,
        "description": "ID program promo / diskon jika ada"
      },
      "diskon_id": {
        "type": "number",
        "example": 1,
        "description": "Alias snake_case untuk diskonId"
      },
      "kodeDiskon": {
        "type": "string",
        "example": "PROMO2026",
        "description": "Kode promo / kupon diskon jika ada"
      },
      "kode_diskon": {
        "type": "string",
        "example": "PROMO2026",
        "description": "Alias snake_case untuk kodeDiskon"
      }
    },
    "required": [
      "spaceId",
      "tanggalReservasi",
      "jamMulai",
      "durasiJam"
    ]
  },
  "UpdateReservationStatusDto": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "disetujui",
          "aktif",
          "selesai",
          "dibatalkan"
        ],
        "example": "disetujui",
        "description": "Status reservasi baru: pending, disetujui, aktif, selesai, dibatalkan"
      }
    },
    "required": [
      "status"
    ]
  },
  "VerifyQrDto": {
    "type": "object",
    "properties": {
      "qrCode": {
        "type": "string",
        "example": "SSB-1725178900000-A3B9F1",
        "description": "String kode QR hasil scan dari aplikasi/tiket member"
      }
    },
    "required": [
      "qrCode"
    ]
  },
  "ProcessCheckinDto": {
    "type": "object",
    "properties": {
      "qrCode": {
        "type": "string",
        "example": "SSB-1725178900000-A3B9F1",
        "description": "String kode QR hasil scan"
      },
      "action": {
        "type": "string",
        "enum": [
          "auto",
          "checkin",
          "checkout"
        ],
        "default": "auto",
        "example": "auto",
        "description": "Aksi check-in / check-out: \"auto\" (otomatis deteksi), \"checkin\", atau \"checkout\""
      }
    },
    "required": [
      "qrCode"
    ]
  },
  "CreateReviewDto": {
    "type": "object",
    "properties": {
      "reservasiId": {
        "type": "number",
        "description": "ID Reservasi yang telah berstatus selesai",
        "example": 1
      },
      "rating": {
        "type": "number",
        "description": "Rating bintang dari 1 hingga 5",
        "example": 5,
        "minimum": 1,
        "maximum": 5
      },
      "komentar": {
        "type": "string",
        "description": "Komentar testimoni atau ulasan pengalaman",
        "example": "Tempat sangat nyaman, koneksi internet kencang dan AC dingin!"
      }
    },
    "required": [
      "reservasiId",
      "rating"
    ]
  },
  "CreateWaitlistDto": {
    "type": "object",
    "properties": {
      "spaceId": {
        "type": "number",
        "description": "ID Ruangan / Space",
        "example": 1
      },
      "tanggal": {
        "type": "string",
        "description": "Tanggal (YYYY-MM-DD)",
        "example": "2026-09-15"
      },
      "jamMulai": {
        "type": "string",
        "description": "Jam mulai (HH:mm)",
        "example": "10:00"
      },
      "durasiJam": {
        "type": "number",
        "description": "Durasi pemakaian dalam jam",
        "example": 2
      }
    },
    "required": [
      "spaceId",
      "tanggal",
      "jamMulai",
      "durasiJam"
    ]
  }
