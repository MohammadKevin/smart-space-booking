  "CreateSpaceDto": {
    "type": "object",
    "properties": {
      "namaSpace": {
        "type": "string",
        "example": "Dedicated Hot Desk #04",
        "description": "Nama ruangan / workstation / desk"
      },
      "tipe": {
        "type": "string",
        "enum": [
          "desk",
