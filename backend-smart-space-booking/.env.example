# Database Configuration
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_smart_space_booking"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=8000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Midtrans Payment Gateway Configuration
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id

# SMTP Email Notification Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_email_smtp_password
SMTP_FROM="WorkNest Notification" <no-reply@example.com>

# Super Admin Provisioning & Financial Settings
SUPER_ADMIN_SECRET_KEY=your_super_admin_provision_secret_key
PLATFORM_COMMISSION_PERCENT=5.0

# Administrative Data Reset Guard (Keep false in production)
ALLOW_DATA_RESET=false
