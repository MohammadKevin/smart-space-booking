# Default points to the live REST API
NEXT_PUBLIC_API_BASE_URL=https://api-ukk.budayakita.com/api

# Or point to local backend server if running locally:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Midtrans Server Configuration (optional, if using frontend direct charge endpoints)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
